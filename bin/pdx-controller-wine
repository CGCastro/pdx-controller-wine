#!/bin/bash
# pdx-controller-wine — launcher for PDX Controller v1.2 under Wine
#
# Usage:
#   pdx-controller-wine                       launch PDX Controller
#   pdx-controller-wine --check               report state, change nothing
#   pdx-controller-wine --install             download + install to prefix
#   pdx-controller-wine --install <path.exe>  install an explicit executable

set -uo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -x "/usr/local/lib/pdx-controller-wine/fetch-pdx.sh" ]; then
    FETCH_SCRIPT="/usr/local/lib/pdx-controller-wine/fetch-pdx.sh"
else
    FETCH_SCRIPT="$PROJECT_DIR/bin/fetch-pdx.sh"
fi
# Runtime priority: env override > /opt system install > per-user
if [ -n "${PDX_RUNTIME:-}" ]; then
    RUNTIME_DIR="$PDX_RUNTIME"
elif [ -x "/opt/pdx-controller-wine/runtime/bin/wine" ]; then
    RUNTIME_DIR="/opt/pdx-controller-wine/runtime"
else
    RUNTIME_DIR="$HOME/.local/share/pdx-controller-wine/runtime"
fi
PREFIX_DIR="${PDX_PREFIX:-$HOME/.local/share/pdx-controller-wine/prefix}"
PDX_EXE="$PREFIX_DIR/drive_c/Program Files/PDX Controller v1.2/PDX Controller.exe"
CACHE_DIR="$HOME/.local/share/pdx-controller-wine/cache"
CACHE_INSTALLER="$CACHE_DIR/PDX Controller.exe"
USER_INSTALLER="$HOME/Transferências/PDX Controller v1.2/PDX Controller.exe"

log() { printf '\033[1;36m[pdx]\033[0m %s\n' "$*"; }
ok()  { printf '  \033[1;32mok\033[0m    %s\n' "$*"; }
warn(){ printf '  \033[1;33mwarn\033[0m  %s\n' "$*"; }
fail(){ printf '  \033[1;31mFAIL\033[0m  %s\n' "$*"; }

check_runtime() {
    local status=0
    if [ ! -x "$RUNTIME_DIR/bin/wine" ]; then
        fail "runtime missing: $RUNTIME_DIR/bin/wine"
        echo "         run: $PROJECT_DIR/bin/build-runtime.sh"
        status=1
    else
        ok "wine: $RUNTIME_DIR/bin/wine"
    fi
    if [ ! -x "$RUNTIME_DIR/bin/wineserver" ]; then
        fail "wineserver missing at $RUNTIME_DIR/bin/"
        status=1
    else
        ok "wineserver: $RUNTIME_DIR/bin/wineserver"
    fi
    if [ -f "$RUNTIME_DIR/lib/wine/x86_64-windows/hidclass.sys" ]; then
        if strings "$RUNTIME_DIR/lib/wine/x86_64-windows/hidclass.sys" > /tmp/pdx-check.txt 2>/dev/null && \
           grep -q "IOCTL_HID_GET_INDEXED_STRING" /tmp/pdx-check.txt; then
            ok "hidclass.sys: patched (IOCTL_HID_GET_INDEXED_STRING present)"
        else
            fail "hidclass.sys: NOT patched"
            status=1
        fi
        rm -f /tmp/pdx-check.txt
    else
        fail "hidclass.sys missing at $RUNTIME_DIR/lib/wine/x86_64-windows/"
        status=1
    fi
    return $status
}

check_prefix() {
    if [ -d "$PREFIX_DIR/drive_c" ]; then
        ok "prefix: $PREFIX_DIR"
    else
        warn "prefix does not exist (will be created on first --run)"
    fi
    if [ -f "$PDX_EXE" ]; then
        ok "PDX Controller: installed ($PDX_EXE)"
    else
        warn "PDX Controller: NOT installed (run --install)"
    fi
    if [ -d "$PREFIX_DIR/drive_c" ]; then
        local dpi
        dpi=$(WINEPREFIX="$PREFIX_DIR" WINEDEBUG=-all "$RUNTIME_DIR/bin/wine" \
            reg query "HKCU\\Control Panel\\Desktop" /v LogPixels 2>/dev/null | \
            tr -d '\r' | \
            awk '/LogPixels/ {print $3; exit}')
        case "$dpi" in
            0xc0) ok "DPI: 192 (2x)" ;;
            0x90) ok "DPI: 144 (1.5x)" ;;
            0x78) ok "DPI: 120 (1.25x)" ;;
            0x60) ok "DPI: 96 (1x)" ;;
            "")   warn "DPI: not set (default 96; use PDX_DPI=192 for HiDPI)" ;;
            *)    warn "DPI: ${dpi} (custom)" ;;
        esac
        local fonts
        fonts=$(WINEPREFIX="$PREFIX_DIR" WINEDEBUG=-all "$RUNTIME_DIR/bin/wine" \
            reg query "HKLM\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Fonts" 2>/dev/null | \
            grep -icE 'arial|times|verdana|georgia|trebuchet')
        if [ "${fonts:-0}" -ge 5 ]; then
            ok "corefonts: registered ($fonts entries)"
        else
            warn "corefonts: not registered (run --install to fix)"
        fi
    fi
}

set_win10() {
    WINEPREFIX="$PREFIX_DIR" WINEDEBUG=-all \
        "$RUNTIME_DIR/bin/wine" reg add "HKLM\\Software\\Microsoft\\Windows NT\\CurrentVersion" \
        /v CurrentVersion /t REG_SZ /d "10.0" /f >/dev/null 2>&1
    WINEPREFIX="$PREFIX_DIR" WINEDEBUG=-all \
        "$RUNTIME_DIR/bin/wine" reg add "HKLM\\Software\\Microsoft\\Windows NT\\CurrentVersion" \
        /v CurrentBuild /t REG_SZ /d "19045" /f >/dev/null 2>&1
}

install_corefonts() {
    if ! command -v winetricks >/dev/null 2>&1; then
        warn "winetricks not installed — fonts will not be registered."
        warn "Install with: sudo apt install --no-install-recommends winetricks"
        return 0
    fi
    log "Installing corefonts (fixes tofu glyphs)..."
    PATH="$RUNTIME_DIR/bin:$PATH" WINE="$RUNTIME_DIR/bin/wine" \
        WINEPREFIX="$PREFIX_DIR" WINEDEBUG=-all \
        winetricks -q corefonts >/dev/null 2>&1 || true
    # winetricks may revert to Win7; reapply
    set_win10
}

set_dpi() {
    local dpi="${PDX_DPI:-192}"
    log "Setting DPI=${dpi} (override with PDX_DPI=<value>)..."
    WINEPREFIX="$PREFIX_DIR" WINEDEBUG=-all \
        "$RUNTIME_DIR/bin/wine" reg add "HKCU\\Control Panel\\Desktop" \
        /v LogPixels /t REG_DWORD /d "$dpi" /f >/dev/null 2>&1
}

ensure_prefix() {
    if [ -d "$PREFIX_DIR/drive_c" ]; then
        return 0
    fi
    log "Creating prefix at $PREFIX_DIR (first run, 2-3 min)..."
    WINEPREFIX="$PREFIX_DIR" WINEARCH=win64 WINEDEBUG=-all \
        "$RUNTIME_DIR/bin/wineboot" -i >/dev/null 2>&1
    WINEPREFIX="$PREFIX_DIR" WINEDEBUG=-all \
        "$RUNTIME_DIR/bin/wine" reg add "HKCU\\Software\\Wine" /v HideWineExports /t REG_SZ /d Y /f >/dev/null 2>&1
    set_win10
    install_corefonts
    set_dpi
    log "Prefix created."
}

install_pdx() {
    local src="${1:-}"
    local from_cache=0
    if [ -z "$src" ]; then
        if [ -f "$USER_INSTALLER" ]; then
            src="$USER_INSTALLER"
        elif [ -f "$CACHE_INSTALLER" ]; then
            src="$CACHE_INSTALLER"
            from_cache=1
        else
            log "Installer not found — downloading to $CACHE_DIR..."
            if ! "$FETCH_SCRIPT"; then
                fail "Download failed. See messages above."
                return 1
            fi
            src="$CACHE_INSTALLER"
            from_cache=1
        fi
    fi
    if [ ! -f "$src" ]; then
        fail "installer not found: $src"
        echo "         usage: $0 --install /path/to/PDX\\ Controller.exe"
        return 1
    fi
    ensure_prefix
    local dest_dir="$PREFIX_DIR/drive_c/Program Files/PDX Controller v1.2"
    mkdir -p "$dest_dir"
    log "Copying $src -> $dest_dir/"
    cp -a "$src" "$dest_dir/"
    local src_dir
    src_dir="$(dirname "$src")"
    if [ -d "$src_dir" ]; then
        for f in "$src_dir"/*.dll "$src_dir"/*.ini "$src_dir"/*.cfg "$src_dir"/*.dat; do
            [ -f "$f" ] || continue
            cp -a "$f" "$dest_dir/"
        done
    fi
    ok "PDX Controller installed at: $PDX_EXE"

    if [ "$from_cache" = "1" ] && [ -f "$src" ]; then
        if [ "${NO_CONFIRM:-0}" = "1" ] || [ ! -t 0 ]; then
            log "(non-interactive — cache kept at $CACHE_DIR)"
        else
            local size
            size=$(du -sh "$CACHE_DIR" 2>/dev/null | cut -f1)
            read -r -p "Delete cached installer ($size)? [y/N] " reply
            case "$reply" in
                [yY]|[yY][eE][sS])
                    rm -rf "$CACHE_DIR"
                    ok "Cache deleted."
                    ;;
            esac
        fi
    fi
}

run_pdx() {
    ensure_prefix
    if [ -n "${PDX_DPI:-}" ]; then
        set_dpi  # re-apply if PDX_DPI explicitly set
    fi
    if [ ! -f "$PDX_EXE" ]; then
        fail "PDX Controller not installed. Run: $0 --install"
        return 1
    fi
    log "Launching PDX Controller..."
    WINEPREFIX="$PREFIX_DIR" WINEDEBUG=-all \
        "$RUNTIME_DIR/bin/wine" "$PDX_EXE" >/tmp/pdx-run.log 2>&1 &
    local pid=$!
    sleep 3
    if kill -0 "$pid" 2>/dev/null; then
        ok "PDX Controller running (PID $pid)"
        ok "Log: /tmp/pdx-run.log"
    else
        fail "PDX Controller exited immediately. Log:"
        tail -20 /tmp/pdx-run.log
        return 1
    fi
}

case "${1:-}" in
    --check)
        log "Runtime check:"
        check_runtime || true
        echo ""
        log "Prefix check:"
        check_prefix || true
        ;;
    --install)
        shift
        install_pdx "${1:-}"
        ;;
    ""|--run)
        run_pdx
        ;;
    --help|-h)
        cat <<'USAGE'
Usage: pdx-controller-wine [OPTION]

Options:
  --check               Report state, change nothing
  --install [path]      Download (or use path) and install to prefix
  --run                 Launch PDX Controller (default)
  --help                Show this help

Environment:
  PDX_DPI=<value>       DPI override (default 192; 96=1x, 144=1.5x)
  PDX_RUNTIME=<path>    Override runtime directory
  PDX_PREFIX=<path>     Override Wine prefix

Examples:
  PDX_DPI=144 pdx-controller-wine                # run at 1.5x
  PDX_DPI=144 pdx-controller-wine --install     # create prefix at 1.5x
  PDX_PREFIX=/tmp/test pdx-controller-wine       # throwaway prefix
USAGE
        ;;
    *)
        echo "Unknown option: $1" >&2
        echo "Usage: $0 [--check|--install [path]|--run] (try --help)" >&2
        exit 1
        ;;
esac
